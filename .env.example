# 图像生成 API 配置（必需 - GPT-Image-2）
IMAGE_GEN_API_KEY=sk-your-api-key-here
IMAGE_GEN_BASE_URL=https://claudex.me/v1
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GEN_QUALITY=high
IMAGE_GEN_TIMEOUT_MS=300000
UPLOAD_RETENTION_HOURS=24

# Agent 文本分析 API 配置（可选 - 用于 AI 策略推荐）
AGENT_API_KEY=sk-your-api-key-here
AGENT_BASE_URL=https://claudex.me/v1
AGENT_MODEL=gpt-5.4-mini
AGENT_TIMEOUT_MS=120000

# 后端服务端口
BACKEND_PORT=3001

# 前端开发服务器端口 (在 vite.config.js 中配置)
FRONTEND_PORT=5173

# Optional PostgreSQL persistence. Leave DATABASE_URL unset to keep the current stateless mode.
DATABASE_URL=postgresql://amazon_image:replace_me@127.0.0.1:5432/amazon_image?schema=public
DATABASE_DEFAULT_ORGANIZATION_SLUG=default
DATABASE_DEFAULT_ORGANIZATION_NAME=Default Organization

# Authentication and first administrator. Keep real values only in backend/.env.
AUTH_ENABLED=true
AUTH_SESSION_DAYS=14
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=

# Private object storage. Leave STORAGE_S3_BUCKET blank for local files.
# MinIO example: STORAGE_S3_ENDPOINT=http://127.0.0.1:9000 and STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
