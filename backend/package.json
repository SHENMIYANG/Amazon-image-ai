{
  "name": "ecommerce-image-gen-backend",
  "version": "0.1.0",
  "description": "Lightweight proxy server for OpenAI API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test:generation-pipeline": "node test-generation-pipeline.js",
    "test:asset-lifecycle": "node test-asset-lifecycle.js",
    "test:request-limits": "node test-request-limits.js",
    "test:generation-response": "node test-generation-response.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "multer": "^2.3.0",
    "openai": "^4.0.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
